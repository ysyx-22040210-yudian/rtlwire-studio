{
  "design": {
    "input_kind": "elab",
    "elab_path": "/path/to/compiled/design.elab++"
  },
  "query": {
    "mode": "trace",
    "check_scopes": [
      "top",
      "top.u_target",
      "top.u_b",
      "top.u_a",
      "top.u_rs"
    ],
    "traversal_boundary": "top",
