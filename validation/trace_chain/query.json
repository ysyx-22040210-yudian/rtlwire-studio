      "scope": "top",
      "signal": "ref_clk"
    },
    "target_modules": [
      "crg",
      "mid_b",
      "mid_a",
      "rs"
    ],
    "observe_signals": [
      {
        "scope": "top",
        "names": [
          "c0",
          "b0",
          "a0",
          "wrong0"
        ]
      }
    ]
  },
  "policy": {
    "traversal": "dependency",
    "timeout_seconds": 120,
    "max_paths": 500
  }
}